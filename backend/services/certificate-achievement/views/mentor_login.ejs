<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Mentor Login</title>
  <link rel="stylesheet" href="/static/style.css"/>
</head>
<body>
<nav class="navbar">
  <a href="/" class="nav-brand">CertVerify</a>
  <span class="nav-tag">Mentor Portal</span>
</nav>
<div class="page-wrap narrow">
  <div class="page-header">
    <h1>Mentor Login</h1>
    <p>Access the mentor review dashboard</p>
  </div>
  <div class="form-card">
    <% if (locals.flash_error) { %>
      <div class="flash-error"><%= flash_error %></div>
    <% } %>
    <form method="POST" action="/mentor/login">
      <div class="field">
        <label>Password</label>
        <input type="password" name="password" placeholder="Enter mentor password" autofocus required/>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn-primary" style="width:100%">Login</button>
      </div>
    </form>
    <p style="text-align:center;margin-top:1rem;font-size:.85rem;color:#666">
      Default password: <code>mentor@123</code>
    </p>
  </div>
</div>
</body>
</html>
