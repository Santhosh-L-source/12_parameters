# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hope_evidence
DB_USER=postgres
DB_PASSWORD=postgres

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=coding-evidence-service
KAFKA_GROUP_ID=coding-evidence-consumer

# Puppeteer
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=30000

# Circuit Breaker
CB_ERROR_THRESHOLD=50
CB_RESET_TIMEOUT=30000
CB_TIMEOUT=20000

# Retry
RETRY_ATTEMPTS=3
RETRY_MIN_TIMEOUT=1000
